{
  "name": "physicslab-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PhysicsLab: 예측 실험실 — 결정론적 물리 엔진 + 스테이지 DSL + 시뮬레이션 데모",
  "scripts": {
