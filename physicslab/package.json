    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "5.6.3",
    "vite": "^7.3.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
